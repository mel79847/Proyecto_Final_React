{
  "name": "picnic-rush-ardillas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:front": "vite --config frontend/vite.config.ts",
    "dev:back": "tsx watch backend/index.ts",
    "build": "npm run build:front",
    "build:front": "vite build --config frontend/vite.config.ts",
    "start": "tsx backend/index.ts",
    "lint": "eslint frontend/src backend --max-warnings=0",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --headed --project=chromium"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  }
}
